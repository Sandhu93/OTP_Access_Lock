FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS builder
WORKDIR /app

COPY package*.json ./
COPY node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_API_BASE_URL=
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
# Docker Desktop cannot reach the default npm registry in this workspace. Download the exact
# Next.js Linux compiler tarball directly from the reachable mirror for this local build only.
RUN node -e "fetch('https://cdn.npmmirror.com/packages/%40next/swc-linux-x64-gnu/15.5.26/swc-linux-x64-gnu-15.5.26.tgz').then(async r => { if (!r.ok) throw new Error('SWC download failed: ' + r.status); require('fs').writeFileSync('/tmp/next-swc.tgz', Buffer.from(await r.arrayBuffer())); })"
RUN mkdir -p node_modules/@next/swc-linux-x64-gnu && tar -xzf /tmp/next-swc.tgz --strip-components=1 -C node_modules/@next/swc-linux-x64-gnu
RUN npm run build

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]

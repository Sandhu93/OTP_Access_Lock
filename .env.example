# Copy to .env outside source control and replace every value before use.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_ALLOWED_HOSTS=localhost
OIDC_ISSUER_URL=https://idp.example.invalid
OIDC_DISCOVERY_URL=https://idp.example.invalid/.well-known/openid-configuration
OIDC_CLIENT_ID=access-lock-dashboard
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_TENANT_CLAIM=tenant_id
OIDC_REQUIRE_MFA=true
OIDC_AUDIENCE=access-lock-admin
KMS_KEY_ID=replace-with-cloud-kms-key-id
MQTT_BROKER_URL=mqtts://broker.example.invalid:8883
MQTT_CA_CERT_PATH=/run/secrets/mqtt-ca.crt
MQTT_CLIENT_CERT_PATH=/run/secrets/backend.crt
MQTT_CLIENT_KEY_PATH=/run/secrets/backend.key
OTP_DELIVERY_PROVIDER=local
OTP_ENCRYPTION_KEY=replace-with-a-random-local-envelope-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-only-keycloak-admin
DEV_SIGNING_SECRET=local-development-signing-secret-change-me
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=./secrets/fcm-service-account.json
DEMO_MQTT_BIND_ADDRESS=127.0.0.1
DEMO_HTTPS_BIND_ADDRESS=127.0.0.1
DEMO_PUBLIC_ORIGIN=https://localhost
OIDC_ISSUER_URL=https://localhost/realms/access-lock
OIDC_PUBLIC_AUTHORIZATION_ENDPOINT=https://localhost/realms/access-lock/protocol/openid-connect/auth
OIDC_TOKEN_ENDPOINT=http://keycloak:8080/realms/access-lock/protocol/openid-connect/token
OIDC_REDIRECT_URI=https://localhost/api/v1/auth/callback
NEXT_PUBLIC_API_BASE_URL=https://localhost

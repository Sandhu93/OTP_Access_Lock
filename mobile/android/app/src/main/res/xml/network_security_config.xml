<?xml version="1.0" encoding="utf-8"?>
<!-- SECURITY-PLACEHOLDER: local demo release trusts user-installed CA certificates; replace with a pinned managed CA before production. See TODO_SECURITY_DEBT.md. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
